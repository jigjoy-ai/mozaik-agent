{
	"name": "@jigjoy/mozaik-agent",
	"version": "0.0.1",
	"description": "An agent harness that brings debugger-like execution control to AI agents.",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"typesVersions": {
		"*": {
			"core": [
				"dist/core/index.d.ts"
			],
			"providers/openai": [
				"dist/providers/openai/index.d.ts"
			]
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jigjoy-ai/mozaik-agent.git"
	},
	"author": "Miodrag Vilotijević",
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"clean": "rimraf dist",
		"format": "prettier --write \"src/**/*.{ts,tsx}\"",
		"example": "tsx examples/simple-loop.ts",
		"example:network": "tsx examples/network.ts",
		"example:function-call": "tsx examples/function-call.ts",
		"prepublishOnly": "npm run build",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit",
		"prepare": "husky"
	},
	"keywords": [
		"mozaik-agent",
		"agent-sdk",
		"agent-debugger",
		"ai-agent-harness",
		"non-blocking agents",
		"loop-engineering",
		"advanced loop engineering",
		"adaptive AI agents",
		"jigjoy",
		"mozaik"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@rstest/core": "^0.10.2",
		"@rstest/coverage-istanbul": "^0.10.2",
		"eslint": "^9.39.5",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.7",
		"prettier": "^3.7.4",
		"rimraf": "^6.1.4",
		"tsup": "^9.0.0",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.6.0",
		"@google/genai": "^2.6.0",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"dotenv": "^17.4.1",
		"openai": "^6.38.0",
		"zod": "^4.3.6"
	}
}
